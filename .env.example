# Пароль для входа в /admin. Обязателен.
ADMIN_PASSWORD=

# Секрет для подписи cookie сессии. Необязателен: без него подпись
# использует ADMIN_PASSWORD (смена пароля разлогинит все сессии).
ADMIN_SECRET=

# Переменные Blob-стора руками задавать не нужно — их добавляет Vercel,
# когда стор подключён к проекту. В зависимости от версии интеграции это
# BLOB_STORE_ID (новая, авторизация по OIDC) или BLOB_READ_WRITE_TOKEN (старая).
# Локально их нет — контент пишется в .data/content.json.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=
