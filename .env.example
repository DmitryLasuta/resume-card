# Пароль для входа в /admin. Обязателен.
ADMIN_PASSWORD=

# Секрет для подписи cookie сессии. Необязателен: без него подпись
# использует ADMIN_PASSWORD (смена пароля разлогинит все сессии).
ADMIN_SECRET=

# Выдаётся Vercel автоматически, когда к проекту подключён Blob-стор.
# Локально можно не задавать — тогда контент пишется в .data/content.json.
BLOB_READ_WRITE_TOKEN=
